# Define restricted files and directories.
restrictedPatterns=(
    '^META-INF/'
    '^bin/'
    '^install/webroot/'
    '^install/translations/[^/]+/strings\.sh$'
    '^module\.prop$'
    '^module\.json$'
    '^module\.yaml$'
    '^install/latest-release-notes\.md$'
    '^webui/package-lock\.json$'
    '^webui/src/locales/[^/]+\.json$'
    '^customize\.sh$'
    '^README\.html$'
)

# Find staged files matching restricted patterns.
while IFS= read -r -d '' file; do
    for pattern in "${restrictedPatterns[@]}"; do
        if [[ "$file" =~ $pattern ]]; then
            git restore --staged -- "$file"
            break
        fi
    done
done < <(git diff --cached --name-only -z)

if git diff --cached --quiet; then
    printf '\033[31mError: All staged files are restricted. Nothing to commit.\033[0m\n'
    exit 1
fi

exit 0